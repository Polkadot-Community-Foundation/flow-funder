# flow-funder configuration. Copy to `.env` and edit, or export these directly.

# People chain node (must expose the archive_v1_storageDiff RPC).
PEOPLE_NODE_URL=wss://paseo-people-next-system-rpc.polkadot.io

# Asset Hub node to fund accounts on.
ASSET_HUB_NODE_URL=wss://paseo-asset-hub-next-rpc.polkadot.io

# Funding account. Defaults to the dev mnemonic + //Alice if unset.
# FUNDER_SEED_PHRASE must be a 12/24-word mnemonic; the derivation path is
# appended to it (e.g. //funder). Use a Redacted/secret manager in production.
# FUNDER_SEED_PHRASE="bottom drive obey lake curtain smoke basket hold race lonely fit walk"
# FUNDER_DERIVATION_PATH=//Alice

# Target free balance per newly-registered account, in plancks. The bot tops
# each account up to this (transfers target - current_free).
# Paseo's native token (PAS) has 10 decimals → 10000000000 = 1 PAS.
FUNDER_AMOUNT_PLANCK=10000000000

# Fat-finger guard: startup fails if FUNDER_AMOUNT_PLANCK exceeds this (default
# 100k PAS). Raise deliberately for a high-value funder.
FUNDER_MAX_AMOUNT_PLANCK=1000000000000000

# Max submission retries on transient pool rejections (nonce drift, dropped tx).
FUNDER_MAX_SUBMIT_RETRIES=3

# Max accounts per Utility.batch_all extrinsic. A block's needing-funding
# accounts are funded in chunks of this size (one tx per chunk), so a large
# catch-up after downtime collapses into a few txs instead of one per account.
FUNDER_BATCH_SIZE=100

# Resume cursor file: hash of the last fully-handled People block. On restart or
# reconnect the watcher resumes its storageDiff from here instead of the tip, so
# registrations during downtime are not missed. Deleting it forces a fresh start
# from the current finalized head.
FUNDER_CURSOR_FILE=flow-funder-cursor.txt

# Backfill from People-chain block 0 on first boot. Existing cursor files still
# take precedence; use a fresh cursor file for an intentional full-chain backfill.
RESERVER_START_FROM_GENESIS=false

# Detect and log registrations but never submit a transfer. Great for a dry run.
FUNDER_DRY_RUN=false

# Health-check HTTP endpoint (GET /health). Defaults to localhost; set the bind
# to 0.0.0.0 only if the endpoint must be reachable off-host (no auth, exposes
# operational counters).
FUNDER_HEALTH_PORT=3033
FUNDER_HEALTH_BIND=127.0.0.1

# Log filter (tracing EnvFilter syntax).
RUST_LOG=flow_funder=info
