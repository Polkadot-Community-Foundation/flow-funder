# flow-funder configuration. Copy to `.env.next`, `.env.preview`, etc. and edit,
# or export these directly. Do not commit real secrets.

# People chain node. Archive/backfill runs require archive RPC support.
PEOPLE_NODE_URL=wss://paseo-people-next-system-rpc.polkadot.io

# Asset Hub node hosting DotnsGateway.
ASSET_HUB_NODE_URL=wss://paseo-asset-hub-next-rpc.polkadot.io

# Reserving signer. This can be the allowance holder or a proxy delegate.
# RESERVER_SEED_PHRASE must be a 12/24-word mnemonic; the derivation path is
# appended to it (for example //wallet). Use Vault/secret manager in production.
# Alternatively, set RESERVER_SECRET_KEY to a raw 32-byte sr25519 secret key hex.
# RESERVER_SEED_PHRASE=bottom drive obey lake curtain smoke basket hold race lonely fit walk
# RESERVER_DERIVATION_PATH=//wallet
# RESERVER_SECRET_KEY=0x...

# Optional allowance holder. Set this when the signer is a proxy delegate rather
# than the account that holds DotnsGateway attestation allowance.
# RESERVER_PROXY_FOR=5...

# Max submission retries on transient pool/finalization failures.
RESERVER_MAX_SUBMIT_RETRIES=3

# Max reserve_name calls per Utility.force_batch extrinsic.
RESERVER_BATCH_SIZE=3

# Max People-chain blocks to decode ahead before submitting reservations. This
# lets sparse registrations from multiple blocks share Asset Hub transactions.
RESERVER_SCAN_WINDOW_BLOCKS=500

# Resume cursor file: hash of the last fully-handled People block. On restart or
# reconnect the watcher resumes from here instead of the tip, so registrations
# during downtime are not missed. Persist this file in production.
RESERVER_CURSOR_FILE=flow-reserver-cursor.txt

# Backfill from People-chain block 0 on first boot. Existing cursor files still
# take precedence; use a fresh cursor file for an intentional full-chain backfill.
RESERVER_START_FROM_GENESIS=false

# Detect and log registrations but never submit reserve_name or persist cursor
# progress. Great for a dry run.
RESERVER_DRY_RUN=false

# Health-check HTTP endpoint (GET /health). Defaults to localhost; set the bind
# to 0.0.0.0 inside containers or if the endpoint must be reachable off-host.
RESERVER_HEALTH_PORT=3033
RESERVER_HEALTH_BIND=127.0.0.1

# Log filter (tracing EnvFilter syntax).
RUST_LOG=flow_funder=info
